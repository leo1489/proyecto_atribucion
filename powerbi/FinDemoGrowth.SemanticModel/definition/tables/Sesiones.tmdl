/// Sesiones de GA4 agregadas por día, canal, fuente/medio, campaña y dispositivo.
table Sesiones
	lineageTag: 67792102-08af-485a-b5a1-7a1a49c56b3d

	/// Sesiones de GA4.
	measure Sesiones = SUM('Sesiones'[Número de sesiones])
		formatString: #,##0
		lineageTag: e1defb0b-ec39-4d25-961d-6788479e6933

	/// Sesiones con interacción (engaged sessions de GA4) sobre sesiones.
	measure 'Tasa de interacción' = DIVIDE(SUM('Sesiones'[Número de sesiones comprometidas]), [Sesiones])
		formatString: 0.0%
		lineageTag: 9ea30b39-0a9c-4626-b409-f46b7955bbae

	/// Día de la sesión.
	column Fecha
		dataType: dateTime
		isHidden
		isAvailableInMdx: false
		lineageTag: ef7854f7-68b6-47fb-8ecf-164a5244f8c8
		sourceColumn: Fecha

	/// Canal de la sesión.
	column Canal
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 4c309eb4-00ae-4f7e-ab80-f75ef7496901
		sourceColumn: Canal

	/// Fuente de tráfico de GA4 (google, facebook, tiktok...).
	column Fuente
		dataType: string
		lineageTag: b90dcc42-2c95-4f96-ac3b-c5bff3220904
		sourceColumn: Fuente

	/// Medio de tráfico de GA4 (cpc, paid_social, organic...).
	column Medio
		dataType: string
		lineageTag: cb958ebc-1375-4ee7-89e2-ca9267879e88
		sourceColumn: Medio

	/// Nombre de campaña (utm_campaign).
	column Campaña
		dataType: string
		lineageTag: 564e6a83-3aec-459b-b444-294b5fedcb11
		sourceColumn: Campaña

	/// Categoría de dispositivo.
	column Dispositivo
		dataType: string
		lineageTag: fef8e936-f258-4829-b5ba-b33c9437e3cc
		sourceColumn: Dispositivo

	/// Sesiones del grupo.
	column 'Número de sesiones'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: ca282213-2cab-48ba-b35f-9bc50ad37471
		sourceColumn: Número de sesiones

	/// Sesiones con interacción (engaged sessions de GA4).
	column 'Número de sesiones comprometidas'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 0b5dde46-94e6-4656-a011-c170593906c7
		sourceColumn: Número de sesiones comprometidas

	/// Usuarios únicos del grupo en el día.
	column 'Número de usuarios'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 9e1e9d65-6c76-4264-babe-1395165958f4
		sourceColumn: Número de usuarios

	partition Sesiones = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaMarts & "fact_sesiones_diarias.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Renombradas = Table.RenameColumns(Encabezados, {{"fecha", "Fecha"}, {"canal", "Canal"}, {"fuente", "Fuente"}, {"medio", "Medio"}, {"campana", "Campaña"}, {"dispositivo", "Dispositivo"}, {"sesiones", "Número de sesiones"}, {"sesiones_comprometidas", "Número de sesiones comprometidas"}, {"usuarios", "Número de usuarios"}}),
				    Tipos = Table.TransformColumnTypes(Renombradas, {{"Fecha", type date}, {"Canal", type text}, {"Fuente", type text}, {"Medio", type text}, {"Campaña", type text}, {"Dispositivo", type text}, {"Número de sesiones", Int64.Type}, {"Número de sesiones comprometidas", Int64.Type}, {"Número de usuarios", Int64.Type}}, "en-US")
				in
				    Tipos

